{
  "functions": {
    "api/chat.py": {
      "runtime": "python@3.12",
      "maxDuration": 60
    },
    "api/health.py": {
      "runtime": "python@3.12",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)",     "dest": "/public/$1" }
  ]
}
